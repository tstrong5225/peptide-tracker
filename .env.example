# Copy this file to .env.local and fill in real values from your Supabase project settings.
# Never commit .env.local — it's already gitignored.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — used only in API routes (invite redemption, PubMed cache writes).
SUPABASE_SERVICE_ROLE_KEY=

# Optional — increases NCBI E-utilities rate limit from 3 req/s to 10 req/s.
# Register free at https://www.ncbi.nlm.nih.gov/account/ to get a key.
NCBI_API_KEY=
